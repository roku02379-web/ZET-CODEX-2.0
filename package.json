{
  "name": "zet-codex",
  "version": "1.0.0",
  "private": true,
  "main": "electron.js",
  "scripts": {
  "dev": "vite",
  "electron": "VITE_DEV_SERVER_URL=http://localhost:5173 electron .",
  "start": "electron .",
  "dist:win": "electron-builder --win --x64"
},
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "vite": "latest",
    "react": "latest",
    "react-dom": "latest"
  },
  "devDependencies": {
    "electron": "latest",
    "electron-builder": "latest"
  },
  "build": {
    "appId": "com.zetcodex.app",
    "productName": "ZET CODEX",
    "win": {
      "target": "nsis"
    },
    "files": [
      "dist/**/*",
      "electron.js",
      "package.json"
    ]
  }
}